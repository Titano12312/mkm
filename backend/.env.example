# Copy to .env
PORT=3000
CLIENT_ORIGIN=*
# For production, lock this to your app origin, e.g.:
# CLIENT_ORIGIN=https://tellaviv.example.com

# --- Supabase persistence (channels + message history) ---
# Find both in Supabase Dashboard → Project Settings → API.
# When unset, the server runs fully in-memory (dev fallback).
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
